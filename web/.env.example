NEXT_PUBLIC_SUPABASE_URL=https://kjncppfwujuedesyyswk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-sb_publishable-key
GEMINI_API_KEY=add-your-server-side-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Server-only Shotstack keys. Use the sandbox key with stage and the production key with v1.
# Keep both keys out of NEXT_PUBLIC_ variables and never commit real values.
SHOTSTACK_SANDBOX_API_KEY=add-your-shotstack-sandbox-key
SHOTSTACK_PRODUCTION_API_KEY=add-your-shotstack-production-key
# stage adds a Shotstack watermark; use v1 only when ready for paid production renders.
SHOTSTACK_ENV=stage
