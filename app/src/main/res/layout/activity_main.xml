<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="E"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@drawable/emm_brand_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="11dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMM Ads Create"
                android:textColor="#17213D"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="AI ADVERTISING STUDIO"
                android:textColor="#8490A8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.11" />
        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="21dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LET'S CREATE"
                android:textColor="#4566E8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Make your next ad stand out."
                android:textColor="#17213D"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Start with your footage. Shape the story. Create with purpose."
                android:textColor="#78829A"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:padding="14dp"
                android:orientation="vertical"
                android:background="@drawable/emm_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="01  /  SOURCE FOOTAGE"
                            android:textColor="#4566E8"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.07" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Add your video"
                            android:textColor="#17213D"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/clipStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOT ADDED"
                        android:textColor="#8490A8"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:background="@drawable/emm_chip_muted" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/videoFrame"
                    android:layout_width="match_parent"
                    android:layout_height="196dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/emm_video_surface">

                    <LinearLayout
                        android:id="@+id/videoPlaceholderGroup"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:gravity="center"
                            android:text="▶"
                            android:textColor="#4566E8"
                            android:textSize="19sp"
                            android:background="@drawable/emm_play_mark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Your video preview"
                            android:textColor="#243152"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Choose a product or service clip to begin"
                            android:textColor="#73809A"
                            android:textSize="11sp"
                            android:gravity="center" />

                        <Button
                            android:id="@+id/uploadClipButton"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginTop="12dp"
                            android:paddingStart="19dp"
                            android:paddingEnd="19dp"
                            android:text="＋  Choose video"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/emm_primary_button"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:stateListAnimator="@null" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/sourceHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="MP4 and other Android-supported video formats"
                    android:textColor="#8791A7"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/briefSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@drawable/emm_surface">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="02  /  THE AD BRIEF"
                    android:textColor="#4566E8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.07" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="What are we advertising?"
                    android:textColor="#17213D"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="A few details help us shape the right message."
                    android:textColor="#78829A"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="PRODUCT OR SERVICE NAME  *"
                    android:textColor="#58647E"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/productNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:hint="e.g. Handmade leather bags"
                    android:textColor="#17213D"
                    android:textColorHint="#98A1B3"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:inputType="textCapSentences"
                    android:background="@drawable/emm_field" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="WHAT MAKES IT WORTH CHOOSING?  *"
                    android:textColor="#58647E"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/productDescriptionInput"
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_marginTop="6dp"
                    android:gravity="top|start"
                    android:padding="13dp"
                    android:hint="Describe what you offer and its main benefit..."
                    android:textColor="#17213D"
                    android:textColorHint="#98A1B3"
                    android:textSize="12sp"
                    android:maxLines="4"
                    android:inputType="textCapSentences|textMultiLine"
                    android:background="@drawable/emm_field" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="WHO SHOULD SEE THIS AD?"
                    android:textColor="#58647E"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/audienceInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:hint="e.g. Students, local shoppers"
                    android:textColor="#17213D"
                    android:textColorHint="#98A1B3"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:inputType="textCapSentences"
                    android:background="@drawable/emm_field" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="WHAT SHOULD THE AD ACHIEVE?"
                    android:textColor="#58647E"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/adGoalInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:hint="e.g. Get enquiries or introduce a product"
                    android:textColor="#17213D"
                    android:textColorHint="#98A1B3"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:inputType="textCapSentences"
                    android:background="@drawable/emm_field" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@drawable/emm_surface">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03  /  OUTPUT SETTINGS"
                    android:textColor="#4566E8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.07" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Give your ad its finish"
                    android:textColor="#17213D"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Choose where it will play and how it should feel."
                    android:textColor="#78829A"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/settingsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
