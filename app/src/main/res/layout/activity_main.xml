<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090B0C">

    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-110dp"
        android:layout_marginEnd="-105dp"
        android:background="@drawable/emm_dark_glow"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/emm_brand_mark"
                android:gravity="center"
                android:text="E"
                android:textColor="#C8EF00"
                android:textSize="21sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMM ADS"
                    android:textColor="#F6F7F4"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.025" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="AI CREATIVE STUDIO"
                    android:textColor="#8B9294"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />
            </LinearLayout>

            <TextView
                android:id="@+id/newAdButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/emm_dark_badge"
                android:gravity="center"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:text="✦  NO SIGN-UP"
                android:textColor="#D9F65A"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/contentScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:paddingBottom="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="19dp"
                android:paddingTop="22dp"
                android:paddingEnd="19dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:id="@+id/homeTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/emm_dark_badge"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:text="✦  YOUR AI CREATIVE PARTNER"
                        android:textColor="#C8EF00"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Make your next"
                        android:textColor="#F5F6F3"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:letterSpacing="-0.035" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ad impossible to ignore."
                        android:textColor="#C8EF00"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:letterSpacing="-0.04" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:text="Start with a video or a simple description. EMM helps turn your idea into an ad."
                        android:textColor="#9AA1A3"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/createPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:background="@drawable/emm_dark_panel"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="START CREATING"
                            android:textColor="#F1F3F0"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.02" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Takes a few steps"
                            android:textColor="#788184"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/videoModeButton"
                            android:layout_width="0dp"
                            android:layout_height="105dp"
                            android:layout_weight="1"
                            android:background="@drawable/emm_dark_choice_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="13dp"
                            android:paddingEnd="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="▶"
                                android:textColor="#C8EF00"
                                android:textSize="23sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Use a video"
                                android:textColor="#F4F6F1"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Upload a clip"
                                android:textColor="#A2AAA5"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ideaModeButton"
                            android:layout_width="0dp"
                            android:layout_height="105dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/emm_dark_choice"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="13dp"
                            android:paddingEnd="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✧"
                                android:textColor="#C8EF00"
                                android:textSize="25sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Describe an idea"
                                android:textColor="#F4F6F1"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Start with text"
                                android:textColor="#A2AAA5"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/videoSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="YOUR SOURCE VIDEO"
                                android:textColor="#B9C0BF"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.09" />

                            <TextView
                                android:id="@+id/clipStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/emm_dark_badge"
                                android:paddingStart="9dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="9dp"
                                android:paddingBottom="5dp"
                                android:text="NO VIDEO"
                                android:textColor="#9BA3A2"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/videoFrame"
                            android:layout_width="match_parent"
                            android:layout_height="185dp"
                            android:layout_marginTop="9dp"
                            android:background="@drawable/emm_dark_video">

                            <LinearLayout
                                android:id="@+id/videoPlaceholderGroup"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="46dp"
                                    android:layout_height="46dp"
                                    android:background="@drawable/emm_video_icon"
                                    android:gravity="center"
                                    android:text="▶"
                                    android:textColor="#C8EF00"
                                    android:textSize="17sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:text="Add a product or service clip"
                                    android:textColor="#E8ECE8"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="MP4, MOV or WebM"
                                    android:textColor="#808A89"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/uploadClipButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="34dp"
                                    android:layout_marginTop="12dp"
                                    android:background="@drawable/emm_dark_badge"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:paddingStart="15dp"
                                    android:paddingEnd="15dp"
                                    android:text="Choose video"
                                    android:textColor="#D9F65A"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </FrameLayout>

                        <TextView
                            android:id="@+id/sourceHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Your video stays on this screen until you continue."
                            android:textColor="#788184"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/briefSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TELL US ABOUT YOUR AD"
                            android:textColor="#B9C0BF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.09" />

                        <EditText
                            android:id="@+id/productNameInput"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/emm_dark_field"
                            android:hint="Product or business name"
                            android:inputType="textCapSentences"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:singleLine="true"
                            android:textColor="#F4F6F2"
                            android:textColorHint="#778180"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/productDescriptionInput"
                            android:layout_width="match_parent"
                            android:layout_height="104dp"
                            android:layout_marginTop="9dp"
                            android:background="@drawable/emm_dark_field"
                            android:gravity="top|start"
                            android:hint="Describe what you are promoting and the kind of ad you want..."
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="500"
                            android:paddingStart="13dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="13dp"
                            android:paddingBottom="12dp"
                            android:textColor="#F4F6F2"
                            android:textColorHint="#778180"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/benefitCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="end"
                            android:text="0 / 500"
                            android:textColor="#697372"
                            android:textSize="9sp" />

                        <EditText
                            android:id="@+id/audienceInput"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/emm_dark_field"
                            android:hint="Who is this ad for? (optional)"
                            android:inputType="textCapSentences"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:singleLine="true"
                            android:textColor="#F4F6F2"
                            android:textColorHint="#778180"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/adGoalInput"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="9dp"
                            android:background="@drawable/emm_dark_field"
                            android:hint="What should the ad achieve? (optional)"
                            android:inputType="textCapSentences"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:singleLine="true"
                            android:textColor="#F4F6F2"
                            android:textColorHint="#778180"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/reviewBriefButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="17dp"
                        android:background="@drawable/emm_dark_primary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Build my ad plan     →"
                        android:textColor="#11150A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="No account needed  ·  Start creating instantly"
                        android:textColor="#747E7C"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="✦  AI-assisted concepts"
                        android:textColor="#8E9895"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="↗  Made for mobile"
                        android:textColor="#8E9895"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>