<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF0F4">

    <View
        android:layout_width="270dp"
        android:layout_height="270dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-115dp"
        android:layout_marginTop="-135dp"
        android:background="@drawable/emm_mesh_warm"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="-105dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/emm_mesh_lime"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            android:layout_marginTop="13dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="9dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:background="@drawable/emm_topbar"
            android:elevation="5dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/emm_brand_mark"
                android:gravity="center"
                android:text="E"
                android:textColor="#C8EF00"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMM Ads Studio"
                    android:textColor="#121316"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:letterSpacing="0.11"
                    android:text="AI ADVERTISING WORKSPACE"
                    android:textColor="#9097A4"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/newAdButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/emm_dark_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:text="+  New ad"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/contentScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:paddingBottom="108dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="22dp"
                android:paddingBottom="30dp">

                <LinearLayout
                    android:id="@+id/homeTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/emm_eyebrow_dot" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:letterSpacing="0.14"
                            android:text="YOUR CREATIVE WORKSPACE"
                            android:textColor="#768091"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Turn good footage"
                        android:textColor="#121316"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:fontFamily="sans" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="into"
                            android:textColor="#121316"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:fontFamily="sans" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="7dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="9dp"
                                android:layout_gravity="bottom"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/emm_headline_highlight" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:text="great ads."
                                android:textColor="#121316"
                                android:textSize="38sp"
                                android:textStyle="bold"
                                android:fontFamily="sans" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Start with your video. Tell us what makes your product worth choosing. EMM helps you shape a story people remember."
                        android:textColor="#78808E"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/startWithVideoButton"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:background="@drawable/emm_lime_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Start with a video   →"
                            android:textColor="#121316"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/exploreBriefButton"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginStart="13dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="Explore the brief  ↗"
                            android:textColor="#717988"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:background="@drawable/emm_hero_panel"
                    android:orientation="vertical"
                    android:padding="21dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.13"
                            android:text="THE EMM APPROACH"
                            android:textColor="#B6C0D0"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/emm_panel_icon"
                            android:gravity="center"
                            android:text="✦"
                            android:textColor="#C8EF00"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:letterSpacing="0.12"
                        android:text="FOOTAGE IN. STORY OUT."
                        android:textColor="#C8EF00"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Make every second of your ad count."
                        android:textColor="#FFFFFF"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:fontFamily="sans" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:background="#353940" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="FROM PRODUCT TO IMPACT     EMM STUDIO  ↗"
                        android:textColor="#AEB5C2"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.07" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/videoSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:background="@drawable/emm_surface"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="17dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.13"
                                android:text="01 / SOURCE VIDEO"
                                android:textColor="#9299A7"
                                android:textSize="8sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="Start with your footage"
                                android:textColor="#121316"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Choose the clip you want to turn into an ad."
                                android:textColor="#858D9A"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/clipStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/emm_status_chip"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp"
                            android:text="NO CLIP"
                            android:textColor="#828A97"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/videoFrame"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/emm_video_surface">

                        <LinearLayout
                            android:id="@+id/videoPlaceholderGroup"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:background="@drawable/emm_video_icon"
                                android:gravity="center"
                                android:text="▶"
                                android:textColor="#C8EF00"
                                android:textSize="19sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="15dp"
                                android:text="Your video will appear here"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="Select a product or service clip from your device to see it in the preview."
                                android:textColor="#A9B0BD"
                                android:textSize="10sp"
                                android:lineSpacingExtra="2dp" />

                            <TextView
                                android:id="@+id/uploadClipButton"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:layout_marginTop="16dp"
                                android:background="@drawable/emm_lime_button"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingStart="17dp"
                                android:paddingEnd="17dp"
                                android:text="+  Choose video"
                                android:textColor="#121316"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/sourceHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Previewed locally on this device  ·  MP4 · MOV · WebM"
                        android:textColor="#929AA7"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/briefSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/emm_surface"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="17dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.13"
                                android:text="02 / PRODUCT BRIEF"
                                android:textColor="#9299A7"
                                android:textSize="8sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="Give your product a voice"
                                android:textColor="#121316"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="A few clear details create a stronger starting point."
                                android:textColor="#858D9A"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/emm_status_chip"
                            android:gravity="center"
                            android:text="✎"
                            android:textColor="#30343D"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="19dp"
                        android:text="PRODUCT OR SERVICE NAME *"
                        android:textColor="#596170"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.07" />

                    <EditText
                        android:id="@+id/productNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="49dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/emm_field_selector"
                        android:hint="e.g. Handmade leather bags"
                        android:inputType="textCapSentences"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="#17191D"
                        android:textColorHint="#9AA2AF"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="WHAT MAKES IT WORTH CHOOSING? *"
                        android:textColor="#596170"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.07" />

                    <EditText
                        android:id="@+id/productDescriptionInput"
                        android:layout_width="match_parent"
                        android:layout_height="102dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/emm_field_selector"
                        android:gravity="top|start"
                        android:hint="Describe what you offer and the main benefit people get..."
                        android:inputType="textCapSentences|textMultiLine"
                        android:padding="14dp"
                        android:textColor="#17191D"
                        android:textColorHint="#9AA2AF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/benefitCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="end"
                        android:text="0 characters"
                        android:textColor="#9AA2AF"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="WHO IS THIS FOR?"
                        android:textColor="#596170"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.07" />

                    <EditText
                        android:id="@+id/audienceInput"
                        android:layout_width="match_parent"
                        android:layout_height="49dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/emm_field_selector"
                        android:hint="e.g. Students, busy parents"
                        android:inputType="textCapSentences"
                        android:maxLength="120"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="#17191D"
                        android:textColorHint="#9AA2AF"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="WHAT SHOULD THE AD DO?"
                        android:textColor="#596170"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.07" />

                    <EditText
                        android:id="@+id/adGoalInput"
                        android:layout_width="match_parent"
                        android:layout_height="49dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/emm_field_selector"
                        android:hint="e.g. Get more enquiries"
                        android:inputType="textCapSentences"
                        android:maxLength="120"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="#17191D"
                        android:textColorHint="#9AA2AF"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="#DDE1E9" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="Your brief gives the creative process a clear starting point."
                        android:textColor="#929AA7"
                        android:textSize="9sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:id="@+id/reviewBriefButton"
                        android:layout_width="match_parent"
                        android:layout_height="47dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/emm_dark_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Review ad brief     →"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:gravity="center"
                    android:letterSpacing="0.09"
                    android:text="EMM ADS STUDIO  /  CREATIVE STARTS HERE"
                    android:textColor="#9AA1AD"
                    android:textSize="7sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/homeDock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="13dp"
        android:background="@drawable/emm_dock"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/homeDockButton"
            android:layout_width="94dp"
            android:layout_height="43dp"
            android:background="@drawable/emm_lime_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/emm_home_icon"
                android:tint="#121316" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="Home"
                android:textColor="#121316"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
